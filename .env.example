# Read by Docker Compose only — the local npm scripts (dev:api, dev:web,
# db:migrate) do not read this file; they have built-in local defaults.

# Required. The database password. Postgres applies it only when the volume
# is first created; changing it later does not change an existing database's
# password. It goes into a URL unescaped, so use URL-safe characters:
#   openssl rand -hex 24
# For local development only, erp_dev_password matches the npm scripts'
# built-in default (the port is bound to 127.0.0.1, so it is not reachable
# from the network).
POSTGRES_PASSWORD=

# Required. Signs session cookies and OAuth2 client tokens — anyone who knows
# it can sign in as any user. Generate a fresh one per installation:
#   openssl rand -hex 32
JWT_SECRET=

# The address users open in the browser (CORS is checked against it).
WEB_ORIGIN=http://localhost:3000

# Leave empty (default): the web app proxies /api/v1/* to the API same-origin,
# so the app works through any hostname. Only set when the API is exposed on
# its own public host.
NEXT_PUBLIC_API_URL=

# Empty (default): Secure on the session cookie follows NODE_ENV, which is
# "production" in the containers. Set to "false" for a plain-HTTP LAN
# deployment (no TLS in front) — otherwise the browser silently drops the
# Secure cookie and login looks broken.
COOKIE_SECURE=

# Empty (default): failed logins are throttled per account only. Behind a
# reverse proxy that writes X-Forwarded-For itself (nginx, Caddy, Cloudflare
# Tunnel) and that all traffic goes through, set TRUST_PROXY=1 to also
# throttle per client IP. (The web container passes the header on untouched
# and adds no entry of its own, so the proxy's last entry is the client.)
# Never set it without such a proxy: the client could then pick its own
# address, and requests without the header would all share one bucket.
TRUST_PROXY=

# Optional. Fixes the one-time code /register asks for while no user exists.
# Empty (default): the api draws a new code at every start and prints it in
# its log (docker compose logs api).
SETUP_CODE=

# Port the host-side scripts (scripts/lib/export-sie.sh) reach the API on.
API_PORT=4000
